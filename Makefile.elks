# native GEM for ELKS

ELKS_ROOT ?= ../elks
ELKS_CROSS ?= $(ELKS_ROOT)/cross/bin
ELKS_TOOLS ?= $(ELKS_ROOT)/elks/tools/bin
HOST_CC ?= cc

ifeq ($(origin CC),default)
CC := $(ELKS_CROSS)/ia16-elf-gcc
endif
ifeq ($(origin AR),default)
AR := $(ELKS_CROSS)/ia16-elf-ar
endif

OBJDUMP ?= $(ELKS_CROSS)/ia16-elf-objdump
NM ?= $(ELKS_CROSS)/ia16-elf-nm
export PATH := $(ELKS_TOOLS):$(PATH)
BUILD_DIR ?= build
OBJ_DIR := $(BUILD_DIR)/obj
TRAP_OBJ_DIR := $(OBJ_DIR)/trap
LIB_DIR := $(BUILD_DIR)/lib
BIN_DIR := $(BUILD_DIR)/bin
MAP_DIR := $(BUILD_DIR)/maps

CPPFLAGS += \
	-DELKS=1 \
	-DUNIX=1 \
	-DI8086=1 \
	-DNDEBUG=1 \
	-DMULTIAPP=1 \
	-DSMALL_DATA=1 \
	-I src/include \
	-I src/aes \
	-I src/vdi \
	-I $(ELKS_ROOT)/libc/include \
	-I $(ELKS_ROOT)/elks/include

BINDINGS_CPPFLAGS := \
	-I src/bindings/original \
	-DUSER_INTIN=1

OPTFLAGS ?= -Os
EXTRA_CFLAGS := $(CFLAGS)
override CFLAGS := \
	$(OPTFLAGS) \
	$(EXTRA_CFLAGS) \
	-mcmodel=medium \
	-melks-libc \
	-march=i8086 \
	-mtune=i8086 \
	-msegment-relocation-stuff \
	-fno-inline \
	-ffunction-sections \
	-fdata-sections \
	-fno-builtin-printf \
	-fno-builtin-fprintf \
	-std=gnu89 \
	-Wall \
	-Wno-implicit-function-declaration \
	-Wno-implicit-int \
	-Wno-int-conversion \
	-Wno-pointer-to-int-cast \
	-Wno-int-to-pointer-cast \
	-Wno-unused-function \
	-Wno-unused-variable \
	-Wno-unused-but-set-variable \
	-Wno-missing-field-initializers

ARFLAGS := rcs

VDI_SRCS := \
	src/vdi/gem_vdi.c \
	src/vdi/gem_input.c \
	src/vdi/drivers/gem_kbd_raw.c \
	src/vdi/drivers/gem_mouse_ms.c \
	src/vdi/drivers/gem_mouse_amstrad.c \
	src/vdi/drivers/gem_pcvideo.c \
	src/vdi/drivers/gem_video_common.c \
	src/vdi/drivers/gem_video_planar.c \
	src/vdi/drivers/gem_video_mono.c \
	src/vdi/drivers/gem_video_cga.c \
	src/vdi/drivers/gem_video_hercules.c \

VDI_ASM_SRCS := src/vdi/drivers/gem_pcvideo_asm.S

RESIDENT_SRCS := \
	src/aes/gem_proc_elks.c \
	src/aes/gem_aes_resident.c \
	src/aes/gem_aes_tick.c \
	src/aes/gem_pending.c \
	src/aes/gem_menu_core.c \
	src/aes/gem_event_resident.c \
	src/aes/gem_form_resident.c \
	src/aes/gem_alert_resident.c \
	src/aes/gem_fsel_resident.c \
	src/aes/gem_graf_resident.c \
	src/aes/gem_resident_memory.c \
	src/aes/gem_aes_call.c \
	src/aes/gem_rsc.c \
	src/aes/gem_resource_resident.c \
	src/aes/gem_scrap_resident.c \
	src/aes/gem_system_resource.c \
	src/aes/gem_menu_object_resident.c \
	src/aes/gem_menu_pull_resident.c \
	src/aes/gem_shell_resident.c \
	src/aes/gem_startup_resident.c \
	src/aes/gem_object_resident.c \
	src/aes/gem_window_resident.c \
	src/aes/gem_far_resource_elks.c \
	src/vdi/gem_vdi_resident.c \
	src/vdi/gem_vdi_output.c \
	src/vdi/gem_vdi_mouse.c \
	src/vdi/gem_vdi_font.c \
	src/vdi/gem_vdi_sysfont.c \
	src/vdi/gem_vdi_text.c \
	src/vdi/gem_vdi_palette.c \
	src/vdi/gem_vdi_sound.c \
	src/server/gem_main.c

DESKTOP_SRCS := \
	src/aes/opengem/desktop.c \
	src/aes/opengem/desk1.c \
	src/aes/opengem/deskact.c \
	src/aes/opengem/deskfun.c \
	src/aes/opengem/deskwin.c \
	src/aes/opengem/deskpro.c \
	src/aes/opengem/deskppd.c \
	src/aes/opengem/deskobj.c \
	src/aes/opengem/deskfpd.c \
	src/aes/opengem/deskins.c \
	src/aes/opengem/deskapp1.c \
	src/aes/opengem/deskapp2.c \
	src/aes/opengem/deskapp3.c \
	src/aes/opengem/deskgraf.c \
	src/aes/opengem/deskrsrc.c \
	src/aes/opengem/deskinf.c \
	src/aes/opengem/deskdir.c \
	src/aes/opengem/deskgsx.c \
	src/aes/opengem/desktype.c \
	src/aes/opengem/deskcds.c \
	src/aes/opengem/optimize.c \
	src/aes/opengem/desksupp.c \
	src/aes/opengem/deskiacc.c \
	src/aes/opengem/gemdesk_posix.c

DESKTOP_DIRECT_SRCS := \
	src/desktop/gemdos_posix.c \
	src/bindings/gem_wordpair.c

# desk accessories stay outside the resident core
DESKTOP_ACC_SRCS := \
	src/aes/opengem/deskacc.c
DESKTOP_ACC_OBJECTS := \
	$(patsubst src/%.c,$(TRAP_OBJ_DIR)/%.o,$(DESKTOP_ACC_SRCS))

# Desktop enters INT 0xef directly.
CLIENT_SRCS := \
	src/desktop/gemdesk_main.c

# direct INT EFh bindings
TRAP_BINDING_SRCS := $(wildcard src/bindings/original/*.c)
DIRECT_BINDING_SRCS := \
	src/bindings/gem_direct_aes.c \
	src/bindings/gem_direct_vdi.c
DIRECT_BINDING_OBJECTS := \
	$(patsubst src/bindings/%.c,\
		$(TRAP_OBJ_DIR)/bindings/%.o,$(DIRECT_BINDING_SRCS))

VDI_OBJECTS := $(patsubst src/%.c,$(OBJ_DIR)/%.o,$(VDI_SRCS))
VDI_ASM_OBJECTS := $(patsubst src/%.S,$(OBJ_DIR)/%.o,$(VDI_ASM_SRCS))
RESIDENT_OBJECTS := $(patsubst src/%.c,$(OBJ_DIR)/%.o,$(RESIDENT_SRCS))
DESKTOP_OBJECTS := $(patsubst src/%.c,$(TRAP_OBJ_DIR)/%.o,$(DESKTOP_SRCS))
DESKTOP_DIRECT_OBJECTS := \
	$(patsubst src/%.c,$(TRAP_OBJ_DIR)/%.o,$(DESKTOP_DIRECT_SRCS))
CLIENT_OBJECTS := \
	$(patsubst src/%.c,$(TRAP_OBJ_DIR)/%.o,$(CLIENT_SRCS))

# apps enter INT 0xef directly
APP_SRCS := \
	src/apps/gemclock.c \
	src/apps/gemcalc.c \
	src/apps/gemview/gemview.c \
	src/apps/gemview/gemview_html.c \
	src/apps/gemview/gemview_net.c
APP_OBJECTS := $(patsubst src/%.c,$(TRAP_OBJ_DIR)/%.o,$(APP_SRCS))
GEMVIEW_OBJECTS := $(TRAP_OBJ_DIR)/apps/gemview/gemview.o \
	$(TRAP_OBJ_DIR)/apps/gemview/gemview_html.o \
	$(TRAP_OBJ_DIR)/apps/gemview/gemview_net.o

# Antler IRC client, direct ELKS sockets
IRC_SRCS := \
	src/apps/irc/gem_irc.c \
	src/apps/irc/gem_irc_app.c \
	src/apps/irc/gem_irc_protocol.c \
	src/apps/irc/gem_irc_transport_elks.c
IRC_OBJECTS := $(patsubst src/%.c,$(TRAP_OBJ_DIR)/%.o,$(IRC_SRCS))
# use the IRC input editor
$(IRC_OBJECTS): CPPFLAGS += -DIRC_AES_INPUT=0
APP_RUNTIME_OBJECT := $(TRAP_OBJ_DIR)/apps/gem_app_vdi.o \
	$(TRAP_OBJ_DIR)/bindings/gem_wordpair.o
TRAP_BINDING_OBJECTS := \
	$(patsubst src/bindings/original/%.c,\
		$(TRAP_OBJ_DIR)/bindings/original/%.o,$(TRAP_BINDING_SRCS))

GEM := $(BIN_DIR)/gem
GEMDESK := $(BIN_DIR)/gemdesk
GEMCLOCK := $(BIN_DIR)/gemclock
GEMCALC := $(BIN_DIR)/gemcalc
GEMVIEW := $(BIN_DIR)/gemview
GEMIRC := $(BIN_DIR)/gemirc
LIBVDI := $(LIB_DIR)/libvdi.a
LIBGEMTRAP := $(LIB_DIR)/libgemtrap.a
ELKS_GEM_PATCH := patches/elks/0001-gemtrap-kernel-broker.patch
IRC_MODEL_TEST := $(BUILD_DIR)/tests/gem_irc_model
.PHONY: all check-elks check-irc patch-elks install clean

all: check-elks $(GEM) $(GEMDESK) $(GEMCLOCK) $(GEMCALC) $(GEMVIEW) $(GEMIRC)

check-elks:
	@test -r "$(ELKS_ROOT)/elks/include/linuxmt/gemtrap.h" || { \
		echo "GEM: ELKS_ROOT has no GEM trap broker." >&2; \
		echo "Run: make -f Makefile.elks patch-elks ELKS_ROOT=$(ELKS_ROOT)" >&2; \
		exit 1; \
	}

patch-elks:
	sh scripts/apply-elks-kernel.sh "$(ELKS_ROOT)"

$(IRC_MODEL_TEST): tests/gem_irc_model.c src/apps/irc/gem_irc_app.c \
		src/apps/irc/gem_irc_protocol.c src/apps/irc/gem_irc_app.h \
		src/apps/irc/gem_irc_protocol.h src/apps/irc/gem_irc_transport.h
	@mkdir -p $(dir $@)
	$(HOST_CC) -std=c89 -Wall -Wextra -Werror -I src/apps/irc \
		tests/gem_irc_model.c src/apps/irc/gem_irc_app.c \
		src/apps/irc/gem_irc_protocol.c -o $@

check-irc: $(IRC_MODEL_TEST)
	$(IRC_MODEL_TEST)

$(LIBVDI): $(VDI_OBJECTS) $(VDI_ASM_OBJECTS)
	@mkdir -p $(dir $@)
	rm -f $@
	$(AR) $(ARFLAGS) $@ $^

$(LIBGEMTRAP): $(TRAP_BINDING_OBJECTS) $(DIRECT_BINDING_OBJECTS)
	@mkdir -p $(dir $@)
	rm -f $@
	$(AR) $(ARFLAGS) $@ $^

$(OBJ_DIR)/%.o: src/%.c | check-elks
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/%.o: src/%.S | check-elks
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(TRAP_OBJ_DIR)/bindings/original/%.o: src/bindings/original/%.c | check-elks
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(BINDINGS_CPPFLAGS) -DGEM_TRAP_FAR_DATA=1 \
		$(CFLAGS) -c $< -o $@

$(TRAP_OBJ_DIR)/bindings/gem_direct_%.o: src/bindings/gem_direct_%.c | check-elks
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(BINDINGS_CPPFLAGS) -DGEM_TRAP_FAR_DATA=1 \
		$(CFLAGS) -c $< -o $@

$(TRAP_OBJ_DIR)/%.o: src/%.c | check-elks
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) -DGEM_TRAP_FAR_DATA=1 \
		$(CFLAGS) -c $< -o $@

$(TRAP_OBJ_DIR)/%.o: src/%.S | check-elks
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) -DGEM_TRAP_FAR_DATA=1 \
		$(CFLAGS) -c $< -o $@

$(DESKTOP_OBJECTS) $(DESKTOP_ACC_OBJECTS): $(wildcard src/aes/opengem/*.h) \
	$(wildcard src/include/*.h)

$(GEM): $(RESIDENT_OBJECTS) $(LIBVDI)
	@mkdir -p $(dir $@) $(MAP_DIR)
	$(CC) $(LDFLAGS) -mcmodel=medium -melks-libc -march=i8086 -mtune=i8086 \
		-msegment-relocation-stuff \
		-maout-stack=4096 -maout-heap=1024 \
		-Wl,--gc-sections -Wl,--icf=all \
		-Wl,-Map,$(MAP_DIR)/gem.map -o $@ \
		$(RESIDENT_OBJECTS) $(LIBVDI)

$(GEMDESK): $(DESKTOP_OBJECTS) $(DESKTOP_DIRECT_OBJECTS) $(DESKTOP_ACC_OBJECTS) \
		$(CLIENT_OBJECTS) $(LIBGEMTRAP)
	@mkdir -p $(dir $@) $(MAP_DIR)
	$(CC) $(LDFLAGS) -mcmodel=medium -melks-libc -march=i8086 -mtune=i8086 \
		-msegment-relocation-stuff \
		-maout-stack=4096 -maout-heap=16384 \
		-Wl,--gc-sections -Wl,--icf=all \
		-Wl,-Map,$(MAP_DIR)/gemdesk.map -o $@ \
		$(CLIENT_OBJECTS) $(DESKTOP_OBJECTS) $(DESKTOP_DIRECT_OBJECTS) \
		$(DESKTOP_ACC_OBJECTS) $(LIBGEMTRAP)

$(GEMCLOCK): $(TRAP_OBJ_DIR)/apps/gemclock.o \
		$(APP_RUNTIME_OBJECT) $(LIBGEMTRAP)
	@mkdir -p $(dir $@) $(MAP_DIR)
	$(CC) $(LDFLAGS) -mcmodel=medium -melks-libc -march=i8086 -mtune=i8086 \
		-msegment-relocation-stuff \
		-maout-stack=2048 -maout-heap=1024 \
		-Wl,--gc-sections -Wl,--icf=all \
		-Wl,-Map,$(MAP_DIR)/gemclock.map -o $@ \
		$(TRAP_OBJ_DIR)/apps/gemclock.o \
		$(APP_RUNTIME_OBJECT) $(LIBGEMTRAP)

$(GEMCALC): $(TRAP_OBJ_DIR)/apps/gemcalc.o \
		$(APP_RUNTIME_OBJECT) $(LIBGEMTRAP)
	@mkdir -p $(dir $@) $(MAP_DIR)
	$(CC) $(LDFLAGS) -mcmodel=medium -melks-libc -march=i8086 -mtune=i8086 \
		-msegment-relocation-stuff \
		-maout-stack=2048 -maout-heap=1024 \
		-Wl,--gc-sections -Wl,--icf=all \
		-Wl,-Map,$(MAP_DIR)/gemcalc.map -o $@ \
		$(TRAP_OBJ_DIR)/apps/gemcalc.o \
		$(APP_RUNTIME_OBJECT) $(LIBGEMTRAP)

$(GEMVIEW): $(GEMVIEW_OBJECTS) \
		$(APP_RUNTIME_OBJECT) $(LIBGEMTRAP)
	@mkdir -p $(dir $@) $(MAP_DIR)
	$(CC) $(LDFLAGS) -mcmodel=medium -melks-libc -march=i8086 -mtune=i8086 \
		-msegment-relocation-stuff \
		-maout-stack=6144 -maout-heap=2048 \
		-Wl,--gc-sections -Wl,--icf=all \
		-Wl,-Map,$(MAP_DIR)/gemview.map -o $@ \
		$(GEMVIEW_OBJECTS) \
		$(APP_RUNTIME_OBJECT) $(LIBGEMTRAP)

$(GEMIRC): $(IRC_OBJECTS) \
		$(APP_RUNTIME_OBJECT) $(LIBGEMTRAP)
	@mkdir -p $(dir $@) $(MAP_DIR)
	$(CC) $(LDFLAGS) -mcmodel=medium -melks-libc -march=i8086 -mtune=i8086 \
		-msegment-relocation-stuff \
		-maout-stack=4096 -maout-heap=1024 \
		-Wl,--gc-sections -Wl,--icf=all \
		-Wl,-Map,$(MAP_DIR)/gemirc.map -o $@ \
		$(IRC_OBJECTS) \
		$(APP_RUNTIME_OBJECT) $(LIBGEMTRAP)

install: all
	install -d $(DESTDIR)/bin $(DESTDIR)/lib/gemsys
	install -m 755 $(GEM) $(DESTDIR)/bin/gem
	install -m 755 $(GEMDESK) $(DESTDIR)/bin/gemdesk
	install -m 755 $(GEMCLOCK) $(DESTDIR)/bin/gemclock
	install -m 755 $(GEMCALC) $(DESTDIR)/bin/gemcalc
	install -m 755 $(GEMVIEW) $(DESTDIR)/bin/gemview
	install -m 755 $(GEMIRC) $(DESTDIR)/bin/gemirc
	install -m 644 assets/lib/gemsys/gem.rsc \
		assets/lib/gemsys/desktop.rsc \
		assets/lib/gemsys/desktop.inf \
		assets/lib/gemsys/deskhi.icn \
		assets/lib/gemsys/desklo.icn \
		assets/lib/gemsys/sysfont.08 \
		assets/lib/gemsys/sysfont.14 \
		assets/lib/gemsys/sysfont.16 \
		$(DESTDIR)/lib/gemsys/

clean:
	rm -rf $(BUILD_DIR)
